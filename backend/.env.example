# Скопируйте в backend/.env и отредактируйте при необходимости:
#   copy .env.example .env

DEBUG=true
DJANGO_SECRET_KEY=dev-insecure-change-me
CORS_ORIGINS=http://localhost:5173

# --- PostgreSQL (если задан POSTGRES_HOST, SQLite не используется) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=lms
POSTGRES_USER=lms
POSTGRES_PASSWORD=lms

# Чтобы снова использовать SQLite, закомментируйте или удалите POSTGRES_HOST

# --- Ollama (автопроверка тест-кейсов) ---
OLLAMA_ENABLED=true
OLLAMA_HOST=http://127.0.0.1:11434
# 7B — лучше по качеству, нужно ~5–6 ГБ свободной ОЗУ. Если Ollama пишет "system memory" — используйте 3B:
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M
# OLLAMA_MODEL=llama3.2:3b-instruct-q4_K_M
OLLAMA_TEMPERATURE=0
OLLAMA_NUM_CTX=4096
OLLAMA_TIMEOUT=120

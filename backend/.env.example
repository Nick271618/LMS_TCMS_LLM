# Скопируйте в backend/.env и отредактируйте при необходимости:
#   copy .env.example .env

DEBUG=true
DJANGO_SECRET_KEY=dev-insecure-change-me
CORS_ORIGINS=http://localhost:5173

# --- PostgreSQL (если задан POSTGRES_HOST, SQLite не используется) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=lms
POSTGRES_USER=lms
POSTGRES_PASSWORD=lms

# Чтобы снова использовать SQLite, закомментируйте или удалите POSTGRES_HOST
